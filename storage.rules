rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /productPhotos/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.token.role in ['admin', 'staff'];
      allow write: if request.auth != null && request.auth.token.role in ['admin', 'staff']
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
