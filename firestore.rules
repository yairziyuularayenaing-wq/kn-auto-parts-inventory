rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.role == 'admin'; }
    function staff() { return signedIn() && request.auth.token.role in ['admin', 'staff']; }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || admin());
      allow write: if false; // roles are managed by trusted Cloud Functions only
    }
    match /products/{productId} {
      allow read: if staff();
      allow write: if false; // all changes through Cloud Functions
    }
    match /stockTransactions/{transactionId} {
      allow read: if staff();
      allow write: if false; // immutable server-created audit records
    }
    match /{document=**} { allow read, write: if false; }
  }
}
